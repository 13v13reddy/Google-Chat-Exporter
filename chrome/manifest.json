{
  "manifest_version": 3,
  "name": "Google Chat Exporter",
  "version": "2.2.0",
  "description": "Export Google Chat conversations to TXT, Markdown, or HTML with media. 100% private — no data leaves your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Google Chat Exporter"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*",
    "https://chat.google.com.mcas.ms/*",
    "https://mail.google.com.mcas.ms/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com.mcas.ms/*",
    "https://*.usercontent.google.com.mcas.ms/*",
    "https://*.googleapis.com.mcas.ms/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*",
        "https://chat.google.com.mcas.ms/*",
        "https://mail.google.com.mcas.ms/*"
      ],
      "js": ["result-host.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["selectors.json", "lib/jszip.min.js", "icons/*", "export-result.html"],
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/*",
        "https://chat.google.com.mcas.ms/*",
        "https://mail.google.com.mcas.ms/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
